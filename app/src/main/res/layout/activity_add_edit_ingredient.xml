<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AddEditIngredientActivity">

    <EditText
        android:id="@+id/editTextIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ingredient Name"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextIngredientQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextIngredientName"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextIngredientUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Unit"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextIngredientQuantity"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextIngredientExpiry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Expiry Date (Optional)"
        android:inputType="date"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextIngredientUnit"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/buttonSaveIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save Ingredient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextIngredientExpiry"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>